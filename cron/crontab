SHELL=/bin/zsh
HOME=/Users/hs094
PATH=/Users/hs094/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
homebrew_prefix=/opt/homebrew


# auto close prs
* * * * * cd "$HOME/.config/scripts/auto-close-prs" && "$HOME/.config/scripts/cron-log.sh" ./auto_close_prs.sh >> "$HOME/.config/logs/auto_pr.log" 2>&1

# update pi
* * * * * "$HOME/.config/scripts/cron-log.sh" pi update --all >> "$HOME/.config/logs/update_pi.log" 2>&1

# regenerate brewfile
0 * * * * "$homebrew_prefix/bin/brew" bundle dump --force --file="$HOME/.config/homebrew/brewfile" >> "$HOME/.config/logs/cron_homebrew_generate.log" 2>&1

# tldr update
*/15 * * * * "$homebrew_prefix/bin/tldr" --update >> "$HOME/.config/logs/tldr_update.log" 2>&1


