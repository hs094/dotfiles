[
  {
    "plugin_id": "chmarax.herdr-nvim",
    "name": "herdr-nvim",
    "version": "1.2.2",
    "min_herdr_version": "0.7.5",
    "description": "Full-height nvim sidebar with agent annotations: toggle with one key, comment code, send to any agent.",
